# Builds Lily from this checkout and mounts the source for live editing:
#   docker compose -f docker-compose.yml.dev up -d --build
services:
  lily:
    image: lily:latest
    build: .
    container_name: lily
    environment:
      - PUID=1000
      - PGID=1000
      - TZ=Europe/London
      - DEVELOP_ON=true   # reload templates on every request
    volumes:
      - /path/to/config:/config
      - /path/to/ingest:/cwa-book-ingest
      - /path/to/library:/calibre-library
      # Live edits: mount the source over the copy in the image
      # - ./cps:/app/calibre-web-automated/cps
      # - ./scripts:/app/calibre-web-automated/scripts
    ports:
      - 8083:8083
    restart: unless-stopped
